#!/bin/sh
# ABOUTME: Claude Code hook script that forwards events to the Atelier app.
# ABOUTME: Reads JSON from stdin, wraps it with CLAUDE_PROJECT_DIR and the
# ABOUTME: inherited ATELIER_SURFACE_ID, and POSTs to localhost. With
# ABOUTME: --permission it waits for a decision and prints it for Claude Code.
INPUT=$(cat)
PORT_FILE="$HOME/Library/Caches/atelier/hook-port"
[ -f "$PORT_FILE" ] || exit 0
PORT=$(cat "$PORT_FILE")

# Both values are interpolated into a JSON string, and a project path may
# legitimately contain a quote or a backslash. Unescaped, one such path would
# silently break every hook event from that project — and a lost event is the
# unsafe direction: it can leave an agent's state reading "finished" while it
# works.
# Control bytes are deleted rather than escaped as \uXXXX: no filesystem path
# legitimately contains one, and the sed gymnastics to emit unicode escapes are
# not worth carrying. INPUT is interpolated raw on purpose — it is the harness's
# own JSON, not a string being embedded in one.
escape_json() {
  printf '%s' "$1" | tr -d '\000-\037' | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}
PROJECT_DIR=$(escape_json "$CLAUDE_PROJECT_DIR")
SURFACE_ID=$(escape_json "$ATELIER_SURFACE_ID")
BODY="{\"event_input\": ${INPUT}, \"project_dir\": \"${PROJECT_DIR}\", \"surface_id\": \"${SURFACE_ID}\"}"

# Registered for PermissionRequest only. Unlike every other event, the agent is
# *stopped* until this returns, so the rule here is that anything short of a
# decision document prints nothing — and printing nothing is exactly the
# behaviour of no hook at all, which leaves Claude Code to ask in the terminal.
if [ "$1" = "--permission" ]; then
  # --max-time sits above the longest hold the app will take
  # (PermissionApprovalSettings.maximumHold), so a slow answer is not cut off
  # here; raising that constant means raising this too. An app that has quit
  # fails the connection immediately rather than waiting out the window, because
  # nothing is listening on the port any more.
  RESPONSE=$(curl -s -X POST "http://127.0.0.1:${PORT}/permission" \
    -H "Content-Type: application/json" \
    -d "$BODY" --max-time 330 2>/dev/null)
  # An error page, a truncated body, or the empty response the app sends when it
  # has no answer must not reach stdout: Claude Code parses this output, and
  # garbage there is worse than silence.
  case "$RESPONSE" in
  *'"hookSpecificOutput"'*) printf '%s' "$RESPONSE" ;;
  esac
  exit 0
fi

curl -s -X POST "http://127.0.0.1:${PORT}/hook" \
  -H "Content-Type: application/json" \
  -d "$BODY" \
  --max-time 1 -o /dev/null 2>/dev/null
exit 0
